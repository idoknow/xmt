{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "xmt-data-v2",
    "namespace": "idoknow",
    "labels": { "app": "xmt", "app.kubernetes.io/part-of": "xmt" }
  },
  "spec": {
    "accessModes": ["ReadWriteOnce"],
    "storageClassName": "local-path",
    "resources": { "requests": { "storage": "40Gi" } }
  }
}
