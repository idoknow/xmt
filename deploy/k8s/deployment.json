{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "xmt",
    "namespace": "idoknow",
    "labels": { "app": "xmt", "app.kubernetes.io/part-of": "xmt" }
  },
  "spec": {
    "replicas": 1,
    "revisionHistoryLimit": 3,
    "progressDeadlineSeconds": 300,
    "strategy": { "type": "Recreate" },
    "selector": { "matchLabels": { "app": "xmt" } },
    "template": {
      "metadata": { "labels": { "app": "xmt" } },
      "spec": {
        "nodeSelector": { "kubernetes.io/hostname": "cn-hk-fxy-01" },
        "tolerations": [
          { "key": "migration.rockchin.top/hold", "operator": "Equal", "value": "true", "effect": "NoSchedule" },
          { "key": "workload.rockchin.top/langbot-cloud-excluded", "operator": "Equal", "value": "true", "effect": "NoSchedule" }
        ],
        "securityContext": { "runAsUser": 0, "runAsGroup": 0 },
        "containers": [
          {
            "name": "web",
            "image": "ghcr.io/idoknow/xmt:latest",
            "imagePullPolicy": "Always",
            "ports": [{ "name": "http", "containerPort": 1145 }],
            "env": [
              { "name": "PORT", "value": "1145" },
              { "name": "DATA_DIR", "value": "/data" },
              { "name": "DIST_DIR", "value": "/app/dist" },
              { "name": "BASE_URL", "value": "https://xmt.idoknow.top" },
              { "name": "TRUST_PROXY", "value": "1" },
              { "name": "OAUTH_ISSUER", "value": "https://gz.campux.top" },
              {
                "name": "OAUTH_CLIENT_ID",
                "valueFrom": { "secretKeyRef": { "name": "xmt-memories", "key": "oauth-client-id", "optional": true } }
              },
              {
                "name": "OAUTH_CLIENT_SECRET",
                "valueFrom": { "secretKeyRef": { "name": "xmt-memories", "key": "oauth-client-secret", "optional": true } }
              },
              {
                "name": "ADMIN_QQ",
                "valueFrom": { "secretKeyRef": { "name": "xmt-memories", "key": "admin-qq", "optional": true } }
              }
            ],
            "readinessProbe": {
              "httpGet": { "path": "/healthz.txt", "port": "http" },
              "initialDelaySeconds": 3,
              "periodSeconds": 5,
              "timeoutSeconds": 3,
              "failureThreshold": 3
            },
            "livenessProbe": {
              "httpGet": { "path": "/healthz.txt", "port": "http" },
              "initialDelaySeconds": 10,
              "periodSeconds": 15,
              "timeoutSeconds": 3,
              "failureThreshold": 3
            },
            "resources": {
              "requests": { "cpu": "25m", "memory": "64Mi" },
              "limits": { "cpu": "600m", "memory": "512Mi" }
            },
            "securityContext": { "allowPrivilegeEscalation": false },
            "volumeMounts": [{ "name": "data", "mountPath": "/data" }]
          }
        ],
        "volumes": [{ "name": "data", "persistentVolumeClaim": { "claimName": "xmt-data" } }]
      }
    }
  }
}
